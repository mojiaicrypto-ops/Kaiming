{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@agentdev/contracts": ["./packages/contracts/src/index.ts"],
      "@agentdev/pi-runtime": ["./packages/pi-runtime/src/index.ts"],
      "@agentdev/domain": ["./packages/domain/src/index.ts"],
      "@agentdev/storage": ["./packages/storage/src/index.ts"],
      "@agentdev/knowledge": ["./packages/knowledge/src/index.ts"],
      "@agentdev/workspace": ["./packages/workspace/src/index.ts"],
      "@agentdev/core": ["./packages/core/src/index.ts"],
      "@agentdev/client": ["./packages/client/src/index.ts"],
      "@agentdev/web": ["./apps/web/src/index.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts"
  ]
}
