<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd user service for AgentDev (`docs/architecture/reliability.md` §7:
  "macOS提供launchd用户服务").

  Install:
    mkdir -p __AGENTDEV_HOME__/logs   # launchd opens StandardOutPath before the daemon runs
    # replace __AGENTDEV_REPO__ with the checkout path, __NODE__ with the node binary and
    # __AGENTDEV_HOME__ with the installation home (default ~/.agentdev)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.agentdev.daemon.plist
    launchctl print gui/$(id -u)/com.agentdev.daemon | head -20
    agentdev status

  Uninstall:
    launchctl bootout gui/$(id -u)/com.agentdev.daemon
    # then confirm: no daemon process, no leftover daemon.lock, `agentdev status` running:false

  A real load/unload drill under a temporary label and a temporary AGENTDEV_HOME is
  `.agentdev/work/WP-12/T6-launchd-drill.sh`.

  The daemon is a single-instance process (`daemon.lock`); `KeepAlive` restarts it after
  a crash, and the recovery scan runs against the databases it left behind.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentdev.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__AGENTDEV_REPO__/apps/daemon/dist/main.js</string>
    <string>--home</string>
    <string>__AGENTDEV_HOME__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__AGENTDEV_HOME__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__AGENTDEV_HOME__/logs/launchd.err.log</string>
</dict>
</plist>
