{
  "name": "agentdev-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:live": "node scripts/live.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "build": "pnpm -r build",
    "doctor": "node apps/cli/dist/cli.js doctor",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "typescript-lint": "npm:typescript@6.0.3",
    "vitest": "5.0.0"
  }
}
