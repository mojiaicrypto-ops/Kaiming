# Copy to kaiming/.env and set a long random access password.
# `./scripts/setup.sh` does this automatically on first install.
KAIMING_ACCESS_PASSWORD=change-me

KAIMING_HOST=127.0.0.1
KAIMING_PORT=4173
KAIMING_DATA_DIR=./.kaiming-data

# Optional default model. Configure models in Settings when these are unset.
# KAIMING_MODEL_PROVIDER=deepseek
# KAIMING_MODEL_ID=deepseek-flash

# Optional runtime limits.
# KAIMING_RUN_STALL_MS=900000
# KAIMING_RUN_TOTAL_MS=5400000
# KAIMING_BASH_TIMEOUT_SECONDS=600
